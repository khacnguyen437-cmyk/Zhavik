local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local Player = Players.LocalPlayer

local CFG = {
    Speed = 24,
    Enabled = true,
    ScanDelay = 0.35,
    ReachDistance = 8
}

local function getCharacter()
    return Player.Character or Player.CharacterAdded:Wait()
end

local function getRoot()
    local character = getCharacter()
    return character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local character = getCharacter()
    return character:FindFirstChildOfClass("Humanoid")
end

local function nearest(tagName)
    local root = getRoot()
    if not root then
        return nil
    end

    local closest = nil
    local closestDistance = math.huge

    for _, obj in ipairs(CollectionService:GetTagged(tagName)) do
        if obj:IsDescendantOf(workspace) then
            local part

            if obj:IsA("BasePart") then
                part = obj
            elseif obj:IsA("Model") then
                part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            end

            if part then
                local distance = (root.Position - part.Position).Magnitude

                if distance < closestDistance then
                    closestDistance = distance
                    closest = obj
                end
            end
        end
    end

    return closest
end

local function moveToObject(obj)
    if not obj then
        return false
    end

    local humanoid = getHumanoid()
    local root = getRoot()

    if not humanoid or not root then
        return false
    end

    local part

    if obj:IsA("BasePart") then
        part = obj
    elseif obj:IsA("Model") then
        part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    end

    if not part then
        return false
    end

    humanoid.WalkSpeed = CFG.Speed
    humanoid:MoveTo(part.Position)

    local startTime = tick()

    while tick() - startTime < 5 do
        root = getRoot()

        if not root then
            return false
        end

        if (root.Position - part.Position).Magnitude <= CFG.ReachDistance then
            return true
        end

        task.wait(0.1)
    end

    return false
end

local function interact(obj)
    if not obj then
        return
    end

    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)

    if prompt then
        -- Xử lý phần thưởng/tương tác bằng server
        -- trong game Roblox Studio của bạn.
    end
end

local function runPriority()
    -- 1. Trứng xịn
    local rareEgg = nearest("RareEgg")

    if rareEgg then
        if moveToObject(rareEgg) then
            interact(rareEgg)
        end

        return
    end

    -- 2. Event
    local eventTask = nearest("EventTask")

    if eventTask then
        if moveToObject(eventTask) then
            interact(eventTask)
        end

        return
    end

    -- 3. Máy chạy bộ
    local treadmill = nearest("Treadmill")

    if treadmill then
        moveToObject(treadmill)
    end
end

